  "terminology": {
    "approved": [
      "ZYRA Basic",
      "ZYRA One",
      "Guardian+",
      "Compatibility Unlock",
      "Compatibility Unlock Plus",
      "End Journey",
      "Active Journey",
      "Paused Journey",
      "Potential Journey",
      "Guardian Network"
    ],
    "retired": {
      "Profile Unlock": "Compatibility Unlock",
      "Unlock Profile": "Compatibility Unlock",
      "Extended Guardian": "Guardian+",
      "End this Journey": "End Journey",
      "GuardianNetworkPreview": "GNContext/GNScene/GNStage"
    },
    "review_only": [
      "preview build",
      "mock data",
      "developer panel",
      "dev-only",
      "PROVISIONAL"
    ]
  },
  "automatic_change_boundary": {
    "allowed": [
      "formatting",
      "verified unused import removal",
      "unambiguous governed literal convention fixes"
    ],
    "prohibited": [
      "redesign",
      "product copy rewrite",
      "pricing change",
      "entitlement change",
      "permission change",
      "flow change",
      "baseline replacement",
      "ambiguous component deletion"
    ]
  },
  "run_policy": {
    "required": [
      "after UI-affecting implementation",
      "before UI feature completion",
      "before release"
    ],
    "overnight": {
      "enabled": false,
      "condition": "relevant UI fingerprint changed since last successful audit",
      "reason_disabled": "Founder/Fable baseline approval pending",
      "ai_when_unchanged": false
    },
    "layers": {
      "L1": "deterministic static inventory and lint; local; $0",
      "L2": "Flutter render, overflow, widget and approved-golden comparison; local; $0",
      "L3": "interpret only new unexplained findings; governed budget required"
    }
  }
