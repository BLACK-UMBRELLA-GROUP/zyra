.DS_Store
**/.DS_Store

# Test seed photos — kept in history by decision (ZYRA_GIT_REMOTE_DECISION
# 2026-08-09 §5); ignored so the folder does not keep growing.
SOURCE/supabase/dev_test_photos/
__pycache__/

# Secrets — never commit (OA-AIOS-307 Finding 2, 2026-08-18)
*.env
*.key
*.pem
*.secret

# Website lives in its own repo (SITE/.git) — see SITE/README.md
SITE/

# Review evidence — screenshots and run snapshots stay on the Mac and the encrypted USB
# (after 30 days), never in git (Founder 2026-10-24; moved here from SYSTEM/RESOURCES/REVIEWS 25 Oct).
# OA-ZYRA-198 evidence stays tracked: Flutter tests pin those files byte for byte.
REPORTS/EVIDENCE/*
!REPORTS/EVIDENCE/OA-ZYRA-198_2026-09-11/

# Test outputs — design captures and failure screenshots are regenerated by the
# tests; they stay on the Mac and the USB, never in git (lessons L11, L15; Founder 2026-10-24).
SOURCE/test/visual/candidates/
SOURCE/test/visual/failures/
SOURCE/test/failures/

# Left-overs a mounted drive creates when an open file is deleted (lesson S12, 25 Oct 2026)
.fuse_hidden*
