// Single ZYRA backend configuration. Only public client keys belong here.
// Use the project's existing default publishable key; no staging fallback.

import 'zyra_app_variant.dart';
import 'zyra_supabase_config_policy.dart';

class SupabaseConfig {
  SupabaseConfig._();

  static const ZyraSupabaseEndpoint _production = ZyraSupabaseEndpoint(
    url: 'https://YOUR-PROJECT-REF.supabase.co',
    publishableKey: 'YOUR-PUBLISHABLE-KEY',
  );
  static ZyraSupabaseEndpoint get active => ZyraSupabaseConfigPolicy.select(
    variant: ZyraAppVariantPolicy.current,
    production: _production,
  );

  static String get url => active.url;
  static String get publishableKey => active.publishableKey;
  static bool get isConfigured => active.isConfigured;
}
