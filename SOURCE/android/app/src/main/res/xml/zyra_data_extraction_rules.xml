<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same device-only policy applies to both cloud backup
     and device-to-device transfer. No plaintext signup fallback is allowed. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="zyra_signup_draft.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:zyra_signup_draft.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:zyra_signup_draft.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="zyra_signup_draft.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:zyra_signup_draft.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:zyra_signup_draft.xml" />
    </device-transfer>
</data-extraction-rules>
